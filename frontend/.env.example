# Copy this to .env (or .env.local) and adjust for your deployment.
# Vite only exposes vars prefixed VITE_ to the browser bundle.

# Where the Flask/Socket.IO backend is reachable from the browser running
# this frontend. Defaults to http://127.0.0.1:5000 if unset (local dev,
# both processes on the same machine).
VITE_BACKEND_URL=http://127.0.0.1:5000

# Map center shown before the first alert ever arrives. Set these to your
# actual intersection's coordinates. Falls back to mock_sender.py's test
# coordinates (42.2808, -83.7430) if unset.
VITE_DEFAULT_LAT=42.2808
VITE_DEFAULT_LON=-83.7430
