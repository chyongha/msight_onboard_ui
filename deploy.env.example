# Copy to deploy.env 
#   cp deploy.env.example deploy.env
# run_all.sh reads deploy.env, so only edit this file 

# --- Backend (Flask/Socket.IO, what the browser talks to) ---
BACKEND_HOST=0.0.0.0        # 0.0.0.0 = reachable from other devices, 127.0.0.1 = this PC only
BACKEND_PORT=5000
FRONTEND_ORIGIN=*

# --- UDP ports the RSU sends to (listeners always bind all interfaces) ---
UDP_ICA_PORT=3436
UDP_RSA_PORT=3434
UDP_SDSM_PORT=3435
EGO_UDP_PORT=4003           

# --- Frontend (browser side) ---
# Where the BROWSER reaches the backend. Same PC: http://127.0.0.1:5000.
# Browser on another device: http://<this-pc's-LAN-ip>:5000
VITE_BACKEND_URL=http://192.168.2.120:5000
VITE_DEFAULT_LAT=42.2975
VITE_DEFAULT_LON=-83.7042

# --- Optional pieces ---
PYV2XLIB_VENDOR_DIR=/Users/yongyong7777/Documents/mcity_sure/msight_ui/msight_onboard_ui/backend/codec/v2xlib        # folder containing v2xlib.py, if not backend/codec/v2xlib/
RUN_GPS_BRIDGE=0            # 1 = also start backend/gps_bridge.py (needs ROS2)
ROS_SETUP=                  # e.g. /opt/ros/humble/setup.bash (only if RUN_GPS_BRIDGE=1)
GPS_TARGET_HOST=127.0.0.1   # where gps_bridge sends fixes (the backend's IP)
