# cp deploy.env.example deploy.env

# --- bakcend ---
BACKEND_HOST=0.0.0.0        # 0.0.0.0 = reachable from other devices 127.0.0.1 = only this pc 
BACKEND_PORT=5000
FRONTEND_ORIGIN=*

# --- UDP ports ---
UDP_ICA_PORT=3436
UDP_RSA_PORT=3434
UDP_SDSM_PORT=3435
EGO_UDP_PORT=4003           # vehicle GPS

# --- Frontend ---
# same pc: http://127.0.0.1:5000.
# browser on another device: http://<this pc lan device>:5000
VITE_BACKEND_URL=http://127.0.0.1:5000
VITE_DEFAULT_LAT=42.2975
VITE_DEFAULT_LON=-83.7042

# --- Optional pieces ---
PYV2XLIB_VENDOR_DIR=/Users/yongyong7777/Documents/mcity_sure/msight_ui/msight_onboard_ui/backend/codec/v2xlib        # folder containing v2xlib.py,
RUN_GPS_BRIDGE=0            # 1 = start backend/gps_bridge.py
ROS_SETUP=none                  # ex. /opt/ros/humble/setup.bash (only if RUN_GPS_BRIDGE=1)
GPS_TARGET_HOST=127.0.0.1   # where gps_bridge sends fixes (the backend's IP)
RELEVANCE_FILTER=0          # 0 = extent relevance is not considered 
DEBUG_HEX=1
